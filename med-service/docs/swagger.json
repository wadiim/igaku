{
    "swagger": "2.0",
    "info": {
        "title": "Igaku Med API",
        "contact": {},
        "version": "0.0.1"
    },
    "host": "localhost:4000",
    "paths": {
        "/med/disease/{name}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieves a paginated list of diseases that match provided substring. Requires Doctor privileges.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Diseases"
                ],
                "summary": "List diseases that match provided substring (Doctor)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Partial disease name to search for (case‑insensitive)",
                        "name": "name",
                        "in": "path"
                    },
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "Page number (default: 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "description": "Number of items per page (default: 10)",
                        "name": "pageSize",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved list of diseases",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/dtos.PaginatedResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/dtos.DiseaseDetails"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request - Invalid query parameters (name, page, pageSize)",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized - Invalid or missing token",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden - User does not have Doctor role",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error - Failed to retrieve diseases",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/med/drug/recommend/{disease}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieves drugs that are indicated for the specified disease. Supports pagination and sorting. Requires Doctor privileges.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Drugs"
                ],
                "summary": "List recommended drugs for a disease (Doctor)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Disease RxNormID",
                        "name": "disease",
                        "in": "path",
                        "required": true
                    },
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "Page number (default: 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "description": "Number of items per page (default: 5)",
                        "name": "pageSize",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "id",
                            "name",
                            "substance"
                        ],
                        "type": "string",
                        "description": "Field to sort by: `id`, `name` or `substance` (default: `id`)",
                        "name": "orderBy",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "asc",
                            "desc"
                        ],
                        "type": "string",
                        "description": "Sort direction: `asc` or `desc` (default: `asc`)",
                        "name": "orderMethod",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved list of recommended drugs",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/dtos.PaginatedResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/dtos.DrugDetails"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request – Invalid query parameters",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized – Invalid or missing token",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden – User does not have Doctor role",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found – Drug not found",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error – Failed to retrieve drugs",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/med/drug/{name}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieves drugs whose names contain the supplied substring. Supports pagination and sorting. Requires Doctor privileges.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Drugs"
                ],
                "summary": "List drugs by name substring (Doctor)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Partial drug name to search for (case‑insensitive)",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "Page number (default: 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "description": "Number of items per page (default: 5)",
                        "name": "pageSize",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "id",
                            "name",
                            "substance"
                        ],
                        "type": "string",
                        "description": "Field to sort by: `id`, `name` or `substance` (default: `id`)",
                        "name": "orderBy",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "asc",
                            "desc"
                        ],
                        "type": "string",
                        "description": "Sort direction: `asc` or `desc` (default: `asc`)",
                        "name": "orderMethod",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved list of drugs",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/dtos.PaginatedResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/dtos.DrugDetails"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request – Invalid query parameters",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized – Invalid or missing token",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden – User does not have Doctor role",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found – No matching drugs",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error – Failed to retrieve drugs",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/med/health": {
            "get": {
                "description": "Returns an OK message",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Check health",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/med/patient/{national_id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieves username, email and national ID of patient. Requires Doctor privileges.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Patient"
                ],
                "summary": "Retrieve data of patient with given national ID (Doctor)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "11‑digit national identification number of the patient",
                        "name": "national_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved patient data",
                        "schema": {
                            "$ref": "#/definitions/dtos.PatientDetails"
                        }
                    },
                    "400": {
                        "description": "Bad Request - Invalid path parameter (national_id)",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized - Invalid or missing token",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden - User does not have Doctor role",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error - Failed to retrieve patient data",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dtos.DiseaseDetails": {
            "type": "object",
            "required": [
                "id",
                "name",
                "rx_norm_id"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "example": "6288b3bd-959f-4b57-a26e-11688e26ce5c"
                },
                "name": {
                    "type": "string",
                    "example": "Pneumonia"
                },
                "rx_norm_id": {
                    "type": "string",
                    "example": "D000111"
                }
            }
        },
        "dtos.DrugDetails": {
            "type": "object",
            "required": [
                "id",
                "name",
                "substance"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "substance": {
                    "type": "string",
                    "example": "oseltamivir"
                }
            }
        },
        "dtos.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Specific error message"
                }
            }
        },
        "dtos.PaginatedResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "page": {
                    "type": "integer"
                },
                "page_size": {
                    "type": "integer"
                },
                "total_count": {
                    "type": "integer"
                },
                "total_pages": {
                    "type": "integer"
                }
            }
        },
        "dtos.PatientDetails": {
            "type": "object",
            "required": [
                "email",
                "national_id",
                "username"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "jdoe@mail.com"
                },
                "national_id": {
                    "type": "string",
                    "example": "44051401458"
                },
                "username": {
                    "type": "string",
                    "example": "jdoe"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}